<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Mixes"
            style="@style/HeadlineMedium"
            android:paddingBottom="12dp"
            android:textColor="@color/primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">
            <LinearLayout
                android:id="@+id/daily_mixes_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Mix cards dynamically added here -->
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recently Played"
            style="@style/HeadlineMedium"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/primary" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">
            <LinearLayout
                android:id="@+id/recently_played_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Recently played cards dynamically added here -->
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Access"
            style="@style/HeadlineMedium"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/primary" />
        <LinearLayout
            android:id="@+id/quick_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- Quick action chips/buttons dynamically added here -->
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You Might Like"
            style="@style/HeadlineMedium"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/primary" />
        <LinearLayout
            android:id="@+id/discover_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Discover cards dynamically added here -->
        </LinearLayout>
    </LinearLayout>
</ScrollView>

